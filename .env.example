# Copy to .env and fill in. Never commit .env. Variable names match backend/app/config.py.
# Real values are shared privately.

# --- Backend core (Alex) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CORS_ORIGINS=["http://localhost:5173"]

# --- Database: Tiger Cloud Postgres (Jamil) ---
DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_HOST:34110/tsdb?sslmode=require

# --- Voice (Jamil) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Sent by ElevenLabs as X-Tool-Secret on server-tool requests (request_payment_approval)
ELEVENLABS_TOOL_SECRET=
# Every call rings this phone (E.164, e.g. +447700900123), whatever business the user names
CALL_NUMBER=
# The Twilio account behind the ElevenLabs phone number; only needed for the chat's Hang up button
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Google Calendar: path to a service account's JSON key, and the calendar shared with it (your Gmail address)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
MAX_CALL_SECONDS=300

# --- Tools (Alex, Phase 2) ---
STRIPE_SECRET_KEY=
RESEND_API_KEY=
# Sender, e.g. "Concierge <onboarding@resend.dev>" (Resend's test sender: only emails your Resend account's address)
EMAIL_FROM=
# Optional: send every confirmation to this address instead of the user's saved email
EMAIL_TO=
