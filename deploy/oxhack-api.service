[Unit]
Description=OxHack Concierge API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=concierge
Group=concierge
WorkingDirectory=/opt/concierge/current/backend
Environment=PYTHONUNBUFFERED=1
Environment=BACKEND_APP=app.main:app
EnvironmentFile=/etc/concierge/api.env
ExecStart=/opt/concierge/current/.venv/bin/python -m uvicorn ${BACKEND_APP} --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/concierge
UMask=0077

[Install]
WantedBy=multi-user.target
